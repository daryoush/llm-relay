{
  "manifest_version": 3,
  "name": "LLM Relay \u2014 clipboard to relay",
  "version": "1.3.0",
  "description": "Relays the clipboard (raw markdown from LLM chat copy buttons, code fences intact) verbatim to your local relay server.",
  "permissions": [
    "storage",
    "contextMenus",
    "scripting",
    "clipboardRead"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://*.kimi.com/*",
    "https://*.kimi.ai/*",
    "https://*.moonshot.cn/*",
    "https://*.moonshot.ai/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://chat.deepseek.com/*",
    "https://chat.qwen.ai/*",
    "https://tongyi.aliyun.com/*",
    "https://www.tongyi.com/*",
    "https://chat.z.ai/*",
    "https://www.z.ai/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Send clipboard to relay server"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "send-last-reply": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Send clipboard content to the relay server"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://chat.deepseek.com/*",
        "https://chat.qwen.ai/*",
        "https://tongyi.aliyun.com/*",
        "https://www.tongyi.com/*",
        "https://chat.z.ai/*",
        "https://www.z.ai/*",
        "https://*.kimi.com/*",
        "https://*.kimi.ai/*",
        "https://*.moonshot.cn/*",
        "https://*.moonshot.ai/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
