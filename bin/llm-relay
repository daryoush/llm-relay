#!/usr/bin/env python3
"""
LLM Relay Server (Python) — command-line configured; there is no config file.

Default behavior on every received message:
  1. PRINT the text to this console
  2. SAVE it to the save target (./instructions.md by default)

Stdlib only, Python 3.7+.

Run it from ANY directory — the LAUNCH DIRECTORY is the instance home:
relative --save-path values resolve against it, and debug_payload.jsonl
is written there.

Install (optional):
  make install      # symlinks bin/llm-relay, bin/run-md, bin/run-llm
                    # into ~/.local/bin

Settings are command-line arguments only (defaults shown):

  --host 127.0.0.1              bind address
  --port 8765                   listen port
  --token ""                    require header X-Relay-Token when non-empty
  --command print-save          print-save | show | save | popup | shell command
  --save-path instructions.md   relative paths resolve against the launch dir
  --append                      append with a --- separator instead of overwriting
  --max-length 200000           truncate longer payloads (0 disables)
  --no-debug-payload            do not append raw request bodies to
                                ./debug_payload.jsonl

commands:
  "print-save"  print to console AND save          (default)
  "show"        print to console only
  "save"        save only
  "popup"       desktop window with the text (tkinter)
  anything else run as a shell command ({content} substitution or stdin)

debug_payload (on by default): the RAW HTTP body of every /send request is
appended to debug_payload.jsonl in the launch directory. Compare that file
with the saved instructions.md to determine whether text was changed in
the CLIENT (raw payload already differs from the page's original markdown)
or in the SERVER (raw payload fine, saved file differs — would be a bug).
"""

import argparse
import json
import os
import shlex
import subprocess
import sys
import threading
from datetime import datetime
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

CFG = {}      # effective settings, built once in main()
HOME = ""     # launch directory; set in main()


def parse_args():
    p = argparse.ArgumentParser(
        prog="llm-relay",
        description="LLM Relay server — receives text POSTed by the browser "
                    "extension, prints and/or saves it. No config file; "
                    "every setting is a command-line argument.")
    p.add_argument("--host", default="127.0.0.1",
                   help="bind address (default: 127.0.0.1)")
    p.add_argument("--port", type=int, default=8765,
                   help="listen port (default: 8765)")
    p.add_argument("--token", default="",
                   help="require header X-Relay-Token when non-empty")
    p.add_argument("--command", default="print-save",
                   help="print-save | show | save | popup | any shell command "
                        "(default: print-save)")
    p.add_argument("--save-path", default="instructions.md", dest="save_path",
                   help="save target; relative paths resolve against the "
                        "launch directory (default: instructions.md)")
    p.add_argument("--append", action="store_true",
                   help="append with a --- separator instead of overwriting")
    p.add_argument("--max-length", type=int, default=200000, dest="max_length",
                   help="truncate longer payloads; 0 disables (default: 200000)")
    p.add_argument("--no-debug-payload", action="store_true",
                   help="do not append raw request bodies to debug_payload.jsonl")
    return p.parse_args()


def instructions_path():
    """Absolute save target: absolute --save-path as-is; relative against
    the launch directory (home)."""
    p = os.path.expanduser(str(CFG.get("save_path") or "instructions.md"))
    if not os.path.isabs(p):
        p = os.path.join(HOME, p)
    return os.path.abspath(p)


# ------------------------------------------------------------------ actions

def cmd_print(text, meta):
    bar = "=" * 70
    print(f"\n{bar}\n📩 {meta['received_at']}  |  source: {meta['source']}"
          f"  |  {len(text)} chars\n{bar}\n{text}\n{bar}\n", flush=True)


def save_message(text):
    path = instructions_path()
    parent = os.path.dirname(path)
    if parent:
        os.makedirs(parent, exist_ok=True)
    append = bool(CFG.get("save_append"))
    sep = ""
    if append and os.path.exists(path) and os.path.getsize(path) > 0:
        sep = "\n\n---\n\n"
    with open(path, "a" if append else "w", encoding="utf-8") as f:
        f.write(sep + text.rstrip() + "\n")
    print(f"💾 saved {len(text)} chars → {path}", flush=True)
    return path


def dump_payload(raw, source):
    """Append the exact HTTP body received — the ground truth of what the
    client sent. Never let debug failures affect the response."""
    try:
        with open(os.path.join(HOME, "debug_payload.jsonl"), "a", encoding="utf-8") as f:
            f.write(json.dumps({
                "ts": datetime.now().isoformat(timespec="seconds"),
                "source": source,
                "raw": raw,
            }) + "\n")
    except Exception as exc:
        print(f"[debug] could not write debug_payload.jsonl: {exc}", flush=True)


def cmd_popup(text):
    code = (
        "import sys, tkinter as tk\n"
        "t = sys.stdin.read()\n"
        "r = tk.Tk(); r.title('LLM Relay')\n"
        "box = tk.Text(r, wrap='word')\n"
        "box.insert('1.0', t)\n"
        "box.pack(fill='both', expand=True, padx=6, pady=6)\n"
        "tk.Button(r, text='Close', command=r.destroy).pack(pady=4)\n"
        "r.geometry('680x520')\n"
        "r.mainloop()\n"
    )
    spawn([sys.executable, "-c", code], text)


def cmd_shell(command, text):
    if "{content}" in command:
        spawn(command.replace("{content}", shlex.quote(text)), shell=True)
    else:
        spawn(command, text, shell=True)


def spawn(cmd, text=None, shell=False):
    p = subprocess.Popen(cmd, shell=shell,
                         stdin=subprocess.PIPE if text is not None else None)
    if text is not None:
        def feed():
            try:
                p.stdin.write(text.encode("utf-8"))
                p.stdin.close()
            except Exception:
                pass
        threading.Thread(target=feed, daemon=True).start()


def run_command(text, meta):
    command = CFG.get("command") or "print-save"
    if command == "print-save":
        cmd_print(text, meta)
        save_message(text)
    elif command == "save":
        save_message(text)
    elif command == "show":
        cmd_print(text, meta)
    elif command == "popup":
        cmd_popup(text)
    else:
        cmd_shell(command, text)


# -------------------------------------------------------------------- server

class RelayHandler(BaseHTTPRequestHandler):

    def _cors(self):
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Access-Control-Allow-Methods", "POST, OPTIONS")
        self.send_header("Access-Control-Allow-Headers", "Content-Type, X-Relay-Token")

    def _reply(self, status, payload):
        body = json.dumps(payload).encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self._cors()
        self.end_headers()
        self.wfile.write(body)

    def do_OPTIONS(self):
        self.send_response(204)
        self._cors()
        self.end_headers()

    def do_POST(self):
        if self.path.split("?")[0].rstrip("/") not in ("", "/send"):
            self._reply(404, {"ok": False, "error": f"unknown path {self.path}"})
            return

        if CFG.get("token") and self.headers.get("X-Relay-Token") != CFG["token"]:
            self._reply(401, {"ok": False, "error": "missing or bad X-Relay-Token"})
            return

        try:
            length = int(self.headers.get("Content-Length") or 0)
        except ValueError:
            length = 0
        raw = self.rfile.read(length).decode("utf-8", errors="replace") if length > 0 else ""

        text = raw
        source = "unknown"
        try:
            data = json.loads(raw)
            if isinstance(data, dict):
                text = str(data.get("text", ""))
                source = str(data.get("source", "unknown"))
        except (ValueError, TypeError):
            pass  # raw text body is also accepted

        if CFG.get("debug_payload", True):
            dump_payload(raw, source)

        text = text.strip()
        if not text:
            self._reply(400, {"ok": False, "error": "empty text"})
            return

        limit = CFG.get("max_length")
        if limit and len(text) > limit:
            text = text[:limit]

        meta = {"source": source,
                "received_at": datetime.now().strftime("%Y-%m-%d %H:%M:%S")}
        try:
            run_command(text, meta)
            self._reply(200, {"ok": True})
        except Exception as exc:
            self._reply(500, {"ok": False, "error": repr(exc)})

    def log_message(self, fmt, *args):
        pass


def main():
    global CFG, HOME
    args = parse_args()
    HOME = os.getcwd()
    CFG = {
        "host": args.host,
        "port": args.port,
        "token": args.token,
        "command": args.command,
        "save_path": args.save_path,
        "save_append": args.append,
        "max_length": args.max_length if args.max_length and args.max_length > 0 else None,
        "debug_payload": not args.no_debug_payload,
    }
    httpd = ThreadingHTTPServer((CFG["host"], int(CFG["port"])), RelayHandler)
    print("─" * 60)
    print(" LLM Relay Server (Python)")
    print(f"   ->  http://{CFG['host']}:{CFG['port']}/send")
    print(f"   command : {CFG['command']!r}")
    print(f"   home    : {HOME}   (launch directory)")
    print(f"   saves to: {instructions_path()}"
          + ("  (appending)" if CFG["save_append"] else ""))
    print(f"   debug   : raw payloads -> {os.path.join(HOME, 'debug_payload.jsonl')}"
          if CFG["debug_payload"] else "   debug   : off")
    print(f"   token   : {'enabled' if CFG['token'] else 'disabled'}")
    print("─" * 60 + "\n", flush=True)
    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        print("\nbye")


if __name__ == "__main__":
    main()
