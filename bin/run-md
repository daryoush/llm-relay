#!/usr/bin/env python3
"""run-md — walk a markdown file, render its prose, and offer to execute
each fenced bash block, with per-block approval.

Usage:
  run-md FILE            (installed via `make install`; 'run-llm' is an alias)
  ./bin/run-md FILE      (from a repo checkout)

Optional dependency: 'rich' renders the markdown nicely when installed;
plain text otherwise.

Fence policy (DESIGN.md §12.4): fences are recognized ONLY at the
beginning of a line; mid-line fence-like sequences are plain text and can
never introduce an executable block.
"""

import argparse
import re
import subprocess
import sys

try:
    from rich.console import Console
    from rich.markdown import Markdown
    console = Console()
    USE_RICH = True
except ImportError:
    USE_RICH = False

# The fence token is built at runtime so this file contains no fence
# sequence that markdown tooling could misinterpret.
FENCE = chr(96) * 3

BASH_RE = re.compile(
    r"^" + FENCE + r"bash[ \t]*\n(.*?)^" + FENCE + r"[ \t]*",
    re.DOTALL | re.MULTILINE,
)


def print_text(text):
    """Prints text, rendering it as Markdown if 'rich' is available."""
    text = text.strip()
    if not text:
        return

    if USE_RICH:
        console.print(Markdown(text))
    else:
        print(text)

    print("\n" + "=" * 60 + "\n")


def process_markdown_file(file_path):
    try:
        with open(file_path, "r", encoding="utf-8") as f:
            content = f.read()
    except FileNotFoundError:
        print(f"Error: File '{file_path}' not found.")
        sys.exit(1)

    last_end = 0
    for match in BASH_RE.finditer(content):
        # 1. Print the markdown text before this bash block
        print_text(content[last_end:match.start()])

        # 2. Extract and display the bash code
        bash_code = match.group(1).strip()
        if not bash_code:
            last_end = match.end()
            continue

        print("\033[1;36m[Bash Block]\033[0m")
        print(bash_code)
        print("-" * 60)

        # 3. Ask for permission
        try:
            choice = input("Execute this bash command? [y/N]: ").strip().lower()
        except (EOFError, KeyboardInterrupt):
            print("\nAborted by user.")
            sys.exit(0)

        # 4. Execute or skip
        if choice == "y":
            print("\033[1;32mExecuting...\033[0m\n")
            result = subprocess.run(["bash", "-c", bash_code])
            if result.returncode != 0:
                print(f"\n\033[1;31mCommand exited with error code {result.returncode}\033[0m")
        else:
            print("\033[1;33mSkipped.\033[0m")

        last_end = match.end()

    # 5. Print any remaining text after the last bash block
    print_text(content[last_end:])


def main():
    ap = argparse.ArgumentParser(
        prog="run-md",
        description="Execute the fenced bash blocks of a markdown file, "
                    "with per-block approval. Fences are recognized only "
                    "at the beginning of a line.")
    ap.add_argument("file", help="the markdown file to process")
    args = ap.parse_args()
    process_markdown_file(args.file)


if __name__ == "__main__":
    main()
